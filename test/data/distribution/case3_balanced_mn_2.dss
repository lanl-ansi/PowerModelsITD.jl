!Clear
New Circuit.case3_balanced
!  define a really stiff source
~ basekv=230 pu=1.00 MVAsc3=200000 MVAsc1=210000

! Substation Transformer
New Transformer.SubXF Phases=3 Windings=2 Xhl=0.01
~ wdg=1 bus=sourcebus conn=delta kv=230   kva=25000    %r=0.0005
~ wdg=2 bus=Substation   conn=delta kv=13.8  kva=25000   %r=0.0005
! ~ Taps=[1.0, 1.0]
! ~ MaxTap=1.10
! ~ MinTap=0.90
! ~ NumTaps=33

! New Regcontrol.Reg1 Transformer=SubXF winding=2 vreg=122 band=2 ptratio=66.4 CTprim=1046



! Substation Transformer
New Transformer.SubXF2 Phases=3 Windings=2 Xhl=0.01
~ wdg=1 bus=sourcebus conn=delta kv=230   kva=25000    %r=0.0005
~ wdg=2 bus=Substation   conn=delta kv=13.8  kva=25000   %r=0.0005
! ~ Taps=[1.0, 1.0]
! ~ MaxTap=1.10
! ~ MinTap=0.90
! ~ NumTaps=33

! New Regcontrol.Reg2 Transformer=SubXF2 winding=2 vreg=122 band=2 ptratio=66.4 CTprim=1046

!Define Linecodes

New linecode.556MCM nphases=3 basefreq=60  ! ohms per 5 mile
~ rmatrix = ( 0.1000 | 0.0400    0.1000 |  0.0400    0.0400    0.1000)
~ xmatrix = ( 0.0583 |  0.0233    0.0583 | 0.0233    0.0233    0.0583)
~ cmatrix = (50.92958178940651  | -0  50.92958178940651 | -0 -0 50.92958178940651  ) ! small capacitance


New linecode.4/0QUAD nphases=3 basefreq=60  ! ohms per 100ft
~ rmatrix = ( 0.1167 | 0.0467    0.1167 | 0.0467    0.0467    0.1167)
~ xmatrix = (0.0667  |  0.0267    0.0667  |  0.0267    0.0267    0.0667 )
~ cmatrix = (50.92958178940651  | -0  50.92958178940651 | -0 -0 50.92958178940651  )  ! small capacitance


!Define lines

New Line.OHLine  bus1=Substation.1.2.3  Primary.1.2.3  linecode = 556MCM   length=1 normamps=6000 emergamps=6000 ! 5 mile line
New Line.Quad    Bus1=Primary.1.2.3  loadbus.1.2.3  linecode = 4/0QUAD  length=1 normamps=6000 emergamps=6000   ! 100 ft
New Line.CB  Phases=3  Bus1=Primary.1.2.3      Bus2=switchbus.1.2.3  Switch=y  r1=1e-4  r0=1e-4  x1=0  x0=0  c1=0  c0=0 enable=y


!LOADSHAPE DEFINITION
New LoadShape.trivial interval=1 npts=2 useactual=no mult=(1.0, 1.0)

New Load.L1 phases=1  loadbus.1.0   ( 13.8 3 sqrt / )   kW=3   kvar=1.5  model=1 daily=trivial
New Load.L2 phases=1  loadbus.2.0   ( 13.8 3 sqrt / )   kW=3   kvar=1.5  model=1 daily=trivial
New Load.L3 phases=1  loadbus.3.0   ( 13.8 3 sqrt / )   kW=3   kvar=1.5 model=1 daily=trivial

Set VoltageBases = "230,13.8"
Set tolerance=0.000001
set defaultbasefreq=60
!Calcvoltagebases
!Solve
